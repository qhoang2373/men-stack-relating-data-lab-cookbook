<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Food</title> 
</head>

<body>
  <h1>Edit Food</h1>

  <form action="/users/<%= user._id %>/foods/<%= food._id%>?_method=PUT" method="POST">
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" value="<%= food.name %>">

    <label for="isHealthy">Is Healthy:</label>
    <input type="checkbox" id="isHealthy" name="isHealthy" <%= food.isHealthy ? 'checked' : '' %>>

    <label for="quantity">Quantity:</label>
    <input type="number" id="quantity" name="quantity" value="<%= food.quantity %>">

    <button type="submit">Save Changes</button>
  </form>
</body>
</html>